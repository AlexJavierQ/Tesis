# Copia este archivo como  secretos.toml  (en la misma carpeta) y pon tu key.
#   Windows:  copy secretos.toml.example secretos.toml
# El secretos.toml real NO se sube al repositorio (esta en .gitignore).

# Key de Groq (gratis, sin tarjeta): https://console.groq.com/keys
GROQ_API_KEY = "gsk_TU_KEY_AQUI"

# Opcional: contrasena del primer administrador. Solo se usa cuando la base de
# datos no tiene usuarios. Si no la defines, se genera una al azar y se muestra
# una vez en la consola al arrancar.
# ADMIN_PASSWORD = ""
